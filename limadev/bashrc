function sshtunnel {
  if [[ $# -lt 3 ]]; then 
    echo "Usage: $0 <host> <host_port> <local_port>" >&2
    return 1
  fi
  local host=$1
  local host_port=$2
  local local_port=$3
  ssh -v -NL $local_port:$host:$host_port $JUMPHOST "$@"
}

