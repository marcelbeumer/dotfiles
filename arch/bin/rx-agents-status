#!/usr/bin/env bash
set -euo pipefail

status() {
  local dst="$1"
  if [[ -L "$dst" ]]; then
    echo "linked:   $dst -> $(readlink "$dst")"
  elif [[ -e "$dst" ]]; then
    echo "unlinked: $dst (exists, not a symlink)"
  else
    echo "unlinked: $dst (missing)"
  fi
}

status "$HOME/.config/opencode"
status "$HOME/.pi"
