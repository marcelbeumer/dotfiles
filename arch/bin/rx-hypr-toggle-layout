#!/usr/bin/env bash
set -euo pipefail

workspace_id=$(hyprctl activeworkspace -j | jq -r '.id // empty')
current_layout=$(hyprctl activeworkspace -j | jq -r '.tiledLayout // "dwindle"')

case "$current_layout" in
  scrolling)
    new_layout="dwindle"
    ;;
  *)
    new_layout="scrolling"
    ;;
esac

hyprctl eval "hl.workspace_rule({ workspace = '$workspace_id', layout = '$new_layout' })" >/dev/null 2>&1 || true
hyprctl dispatch 'hl.dsp.layout("fit active")' >/dev/null 2>&1 || true
