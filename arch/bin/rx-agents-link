#!/usr/bin/env bash
set -euo pipefail

script_path="$(readlink -f "$0")"
agents_dir="$(cd "$(dirname "$script_path")/../agents" && pwd)"

link() {
  local src="$1" dst="$2"
  if [[ -L "$dst" ]]; then
    rm "$dst"
  elif [[ -e "$dst" ]]; then
    echo "ERROR: $dst exists and is not a symlink" >&2
    return 1
  fi
  mkdir -p "$(dirname "$dst")"
  ln -s "$src" "$dst"
}

# Migrate existing pi state into the repo before linking.
pi_agent="$agents_dir/pi/agent"
if [[ -d "$HOME/.pi/agent" ]]; then
  for item in auth.json models-store.json sessions; do
    if [[ -e "$HOME/.pi/agent/$item" && ! -e "$pi_agent/$item" ]]; then
      cp -r "$HOME/.pi/agent/$item" "$pi_agent/$item"
    fi
  done
fi

link "$agents_dir/opencode" "$HOME/.config/opencode"
link "$agents_dir/pi" "$HOME/.pi"

echo "agents linked"
