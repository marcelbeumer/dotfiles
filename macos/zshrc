autoload -Uz compinit compinit
ulimit -n 10240
bindkey -e

PROMPT='%2~ %# '

export PATH=$HOME/bin:$PATH
export PATH=/usr/local/go/bin:$PATH
export PATH=$HOME/go/bin:$PATH
export PATH=$HOME/.cargo/bin:$PATH
export PATH=$HOME/.local/bin:$PATH
export PATH=$HOME/bin:$PATH
export PATH="$HOME/.local/share/nvim/mason/bin:$PATH"
export PATH="./node_modules/.bin:$PATH"
export CDPATH=.:~/g
export EDITOR=nvim
export KEYTIMEOUT=1

alias g='git'
alias d='docker'
alias tf='terraform'
alias ports='sudo lsof -P -i TCP -s TCP:LISTEN'
alias k='kubectl'
alias ll='ls -allh'
alias startdev="limactl start dev0"
alias stopdev="limactl stop dev0"
alias dev="limactl shell --workdir . dev0"

rp() { ( cd "$1" >/dev/null 2>&1 && pwd ); }

enable_proxy() {
  export HTTP_PROXY=$CONF_HTTP_PROXY
  export HTTPS_PROXY=$CONF_HTTPS_PROXY
  export NO_PROXY=$CONF_NO_PROXY
}

disable_proxy() {
  unset HTTP_PROXY
  unset HTTPS_PROXY
  unset NO_PROXY
}

function sshtunnel {
  if [[ $# -lt 3 ]]; then 
    echo "Usage: $0 <host> <host_port> <local_port>" >&2
    return 1
  fi
  local host=$1
  local host_port=$2
  local local_port=$3
  ssh -v -NL $local_port:$host:$host_port $JUMPHOST "$@"
}

source_export() {
  set -a
  source $1
  set +a
}

function nvim_presenting {
  export NVIM_DARK=1 
  export NVIM_LESS_COLORS=0 
  export NVIM_COLORSCHEME=catppuccin 
}

function nvim_default {
  export NVIM_DARK=1
  export NVIM_LESS_COLORS=1
  export NVIM_COLORSCHEME=default
}

nvim_default

FNM_PATH="$HOME/.local/share/fnm"
if [ -d "$FNM_PATH" ]; then
  export PATH="$FNM_PATH:$PATH"
  eval "`fnm env`"
fi

if [[ -f "$HOME/.cargo/env" ]]; then
  . "$HOME/.cargo/env"
fi

if [ -f ~/.zsh_local ]; then
  . ~/.zsh_local
fi
